# PostgreSQL connection used by the ETL pipeline
DB_HOST=localhost
DB_PORT=5432
DB_NAME=manufacturing_dw
DB_USER=postgres
DB_PASSWORD=postgres

# Optional: set a full SQLAlchemy connection string instead of the fields above.
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/manufacturing_dw

# Never commit real production credentials. Copy this file to .env for local use.
