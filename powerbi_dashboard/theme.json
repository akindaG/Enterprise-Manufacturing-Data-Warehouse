{
  "name": "Enterprise Manufacturing Analytics",
  "dataColors": [
    "#1F4E78",
    "#2F75B5",
    "#70AD47",
    "#FFC000",
    "#C55A11",
    "#5B9BD5",
    "#A5A5A5",
    "#4472C4"
  ],
  "background": "#F7F9FC",
  "foreground": "#1F2937",
  "tableAccent": "#1F4E78",
  "good": "#70AD47",
  "neutral": "#FFC000",
  "bad": "#C00000",
  "maximum": "#1F4E78",
  "center": "#A5A5A5",
  "minimum": "#D9EAF7",
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": { "solid": { "color": "#1F2937" } }
          }
        ],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E5E7EB" } },
            "radius": 6
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 18,
            "color": { "solid": { "color": "#1F4E78" } }
          }
        ]
      }
    }
  },
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#1F2937"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1F2937"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#374151"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 20,
      "color": "#1F4E78"
    }
  }
}
